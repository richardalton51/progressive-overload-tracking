{
  "expo": {
    "name": "Progressive Overload",
    "slug": "progressive-overload",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/progressive-overload-thumbnail.png",
    "scheme": "progressiveoverload",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/progressive-overload-thumbnail.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.richardalton.progressiveoverload"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/progressive-overload-thumbnail.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b31f3177-bdcb-4ee4-a830-482ccdcb493a"
      },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b31f3177-bdcb-4ee4-a830-482ccdcb493a"
      }
    }
    },
    "owner": "richardalton"
  }
}